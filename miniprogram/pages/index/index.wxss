/**index.wxss**/
page {
  background-color: #0a0a0c;
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background: 
    radial-gradient(circle at 80% 20%, rgba(120, 130, 180, 0.15) 0%, transparent 40%),
    radial-gradient(circle at 20% 80%, rgba(80, 90, 140, 0.1) 0%, transparent 50%),
    linear-gradient(135deg, #0b0c10 0%, #1a1a24 50%, #050608 100%);
}

/* 毛玻璃质感中央卡片 */
.glass-card {
  position: relative;
  z-index: 2;
  width: 85%;
  max-width: 600rpx;
  padding: 60rpx 40rpx;
  background: rgba(26, 26, 31, 0.4);
  border-radius: 32rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 52rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.8);
}

.sub-title {
  font-size: 28rpx;
  color: #a0a0a8;
  margin-bottom: 70rpx;
  letter-spacing: 2rpx;
}

.join-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.join-section loading-button {
  width: 100%;
}

.verification-code-container {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 50rpx;
}

/* 优化输入框：去除生硬粗线，改为暗沉带微光 */
.code-input {
  width: 100rpx;
  height: 120rpx;
  background-color: rgba(0, 0, 0, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  text-align: center;
  font-size: 52rpx;
  font-weight: bold;
  color: #ffd700;
  box-shadow: inset 0 2rpx 10rpx rgba(0, 0, 0, 0.5);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.code-input:focus {
  border-color: rgba(255, 215, 0, 0.8);
  box-shadow: 0 0 24rpx rgba(255, 215, 0, 0.3), inset 0 2rpx 10rpx rgba(0, 0, 0, 0.5);
  transform: translateY(-4rpx);
  background-color: rgba(20, 20, 25, 0.6);
}

.divider-text {
  color: rgba(255, 255, 255, 0.3);
  font-size: 26rpx;
  margin: 40rpx 0;
  letter-spacing: 1px;
}

loading-button {
  width: 100%;
}

/* 授权弹窗样式 */
.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.8);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  background: #1a1a1f;
  width: 85%;
  max-width: 600rpx;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: slideUp 0.25s ease-out;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
}

@keyframes slideUp {
  from {
    transform: translateY(40rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  color: #ffffff;
}

.modal-desc {
  font-size: 26rpx;
  color: #888888;
  margin-bottom: 40rpx;
}

.nickname-input {
  width: 100%;
  height: 90rpx;
  background: #2a2a30;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
  font-size: 30rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s ease;
}

.nickname-input:focus {
  border-color: #ffd700;
}

.privacy-tip {
  font-size: 22rpx;
  color: #666666;
  margin-bottom: 40rpx;
  text-align: center;
}

.modal-actions {
  width: 100%;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  border: none;
  margin: 0;
  padding: 0;
  transition: all 0.2s ease;
}

.modal-btn::after {
  border: none;
}

.modal-btn.cancel {
  background: #2a2a30;
  color: #888888;
}

.modal-btn.cancel:active {
  background: #3a3a40;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #ffd700 0%, #ffaa00 100%);
  color: #000000;
  font-weight: bold;
}

.modal-btn.confirm:active {
  transform: scale(0.98);
}
