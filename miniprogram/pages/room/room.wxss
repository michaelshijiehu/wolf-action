/* 3D 翻牌弹窗核心样式 */
.role-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.85);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
  backdrop-filter: blur(10px);
}

.role-modal.show {
  opacity: 1;
}

.role-card-3d {
  width: 580rpx;
  height: 900rpx;
  perspective: 2000rpx;
  transition: transform 0.3s ease;
  transform: scale(0.8);
}

.role-modal.show .role-card-3d {
  transform: scale(1);
}

.role-card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  transform-style: preserve-3d;
}

.role-card-3d.flipped .role-card-inner {
  transform: rotateY(180deg);
}

.role-card-face {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
  border: 4rpx solid rgba(255, 215, 0, 0.3);
}

.role-card-back {
  background: linear-gradient(135deg, #1a1a1e 0%, #2c2c34 100%);
  z-index: 2;
  transform: rotateY(0deg);
}

.role-card-front {
  background: #1a1a1e;
  transform: rotateY(180deg);
  z-index: 1;
}

/* 兼容性兜底：当翻转时强制切换 z-index */
.role-card-3d.flipped .role-card-front {
  z-index: 3;
}

.close-card-hint {
  margin-top: auto;
  font-size: 22rpx;
  color: #666;
  text-decoration: underline;
  padding: 20rpx;
}

.role-name-large {
  font-size: 72rpx;
  color: #faad14;
