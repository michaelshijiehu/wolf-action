/* pages/room/room.wxss */
/* 房间不存在/已解散页面样式 */
.not-found-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  background: radial-gradient(circle at center, #1a1a1e 0%, #0a0a0c 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.not-found-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 80%;
  animation: fadeIn 0.8s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.not-found-icon-wrapper {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 60rpx;
}

.icon-circle {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 2rpx dashed rgba(255, 215, 0, 0.2);
  animation: rotate 10s linear infinite;
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.ghost-icon {
  font-size: 100rpx;
  filter: grayscale(100%) opacity(0.5);
}

.not-found-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.not-found-hint {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 80rpx;
  text-align: center;
}

.return-btn {
  width: 340rpx !important;
  height: 100rpx !important;
  line-height: 100rpx !important;
  background: linear-gradient(135deg, #ffd700, #ffae00) !important;
  color: #000 !important;
  font-weight: bold;
  font-size: 32rpx;
  border-radius: 50rpx;
  box-shadow: 0 10rpx 30rpx rgba(255, 174, 0, 0.2);
  margin: 0 !important;
}

.return-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* 待入座玩家侧边栏 */
.unseated-sidebar {
  position: fixed;
  top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}

.unseated-sidebar.left {
  left: 0;
}

.unseated-sidebar.right {
  right: 0;
}

.visitor-item {
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: slideIn 0.5s ease-out;
  background: rgba(0, 0, 0, 0.3);
  padding: 10rpx 6rpx;
  backdrop-filter: blur(5px);
  pointer-events: auto;
}

.visitor-item:active {
  background: rgba(255, 215, 0, 0.2);
}

.unseated-sidebar.left .visitor-item {
  border-radius: 0 40rpx 40rpx 0;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-left: none;
}

.unseated-sidebar.right .visitor-item {
  border-radius: 40rpx 0 0 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-right: none;
}

.visitor-img {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.visitor-name {
  font-size: 14rpx;
  color: #aaa;
  margin-top: 4rpx;
  max-width: 60rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.container {
  background-color: transparent;
  min-height: 100vh;
  padding: 20rpx;
  color: #fff;
  display: flex;
  flex-direction: column;
  transition: background-color 1s ease, color 0.5s ease;
  padding-bottom: calc(250rpx + env(safe-area-inset-bottom));
  position: relative;
}

/* 沉浸式全局动态渐变背景 */
.bg-gradient-room {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: -1;
  transition: background 1.5s ease;
}

/* 夜晚：深邃暗黑与幽紫月光晕染 */
.bg-gradient-room.night {
  background: 
    radial-gradient(circle at 50% -10%, rgba(75, 45, 110, 0.25) 0%, transparent 60%),
    linear-gradient(180deg, #0a0b10 0%, #020203 100%);
}

/* 白天：清晨冷调蓝紫与较亮的底色 */
.bg-gradient-room.day {
  background: 
    radial-gradient(circle at 50% -10%, rgba(120, 160, 220, 0.35) 0%, transparent 70%),
    linear-gradient(180deg, #181c26 0%, #0c0e14 100%);
}

/* 容器的遮罩只需极其微弱的蓝光即可，让后面的滤镜背景透出来 */
.container.day-mode {
  background-color: rgba(200, 220, 255, 0.1);
  color: #fff;
}

.container.day-mode .seat-name {
  color: #fff;
}

.container.day-mode .header {
  color: #ddd;
}



/* 结束/跳过按钮样式优化 */
.skip-btn {
  margin-top: 20rpx;
  background: rgba(255, 255, 255, 0.1) !important;
  color: #ddd !important;
  font-size: 26rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 30rpx;
  padding: 10rpx 40rpx;
  line-height: 1.5;
}

.day-mode .skip-btn {
  background: rgba(255, 255, 255, 0.1) !important;
  color: #eee !important;
  border-color: rgba(255, 255, 255, 0.4) !important;
}

.header {
  display: none;
  /* Hide header as Room ID is in Title */
}

/* 拖拽区域样式 */
.table-drag-area {
  width: 100%;
  height: 800rpx;
  margin-top: 20rpx;
  overflow: hidden;
  position: relative;
  z-index: 5;
}

.table-drag-area.full {
  height: 1000rpx;
  margin-top: -50rpx;
}

.table-movable-view {
  width: 700rpx;
  height: 700rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.table-movable-view.theater {
  width: 1000rpx;
  height: 1000rpx;
}

.table-container {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  transition: background 1s ease, border 1s ease, box-shadow 1s ease;

  /* 全透玻璃质感底色 */
  background: rgba(10, 10, 15, 0.4);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);

  /* 细光边框与玻璃反光 */
  border: 4rpx solid rgba(255, 255, 255, 0.08);

  /* 多层环境光效：
     inset 第一层：桌面内部的边缘反光
     外层第一层：深邃的悬浮阴影
     外层第二层：背景光环境晕染
  */
  box-shadow:
    inset 0 0 50rpx rgba(255, 255, 255, 0.05),
    0 20rpx 60rpx rgba(0, 0, 0, 0.7),
    0 0 100rpx rgba(0, 0, 0, 0.5);
}

/* 移除旧的 Theater Mode 宽高限制，由 Movable View 控制 */
.table-container.theater-mode {
  width: 100%;
  height: 100%;
  margin-top: 0;
  transform: none;
  border-color: #333;
}

.theater-toggle {
  position: fixed;
  left: 30rpx;
  top: 120rpx;
  /* Log 下方 */
  background: rgba(0, 0, 0, 0.6);
  border: 1px solid #444;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  z-index: 100;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.3);
  transition: all 0.2s;
  color: #ffd700;
}

.theater-toggle:active {
  transform: scale(0.9);
  background: rgba(0, 0, 0, 0.8);
}

/* 桌面内部装饰环 */
.table-container::after {
  content: '';
  position: absolute;
  top: 40rpx;
  left: 40rpx;
  right: 40rpx;
  bottom: 40rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(255, 255, 255, 0.1);
  pointer-events: none;
  box-shadow: inset 0 0 20rpx rgba(0, 0, 0, 0.5);
}

.table-container.day {
  /* 白天模式全透玻璃质感蓝紫打底 */
  background: rgba(200, 220, 255, 0.15);
  border-color: rgba(255, 255, 255, 0.3);

  /* 白天环境光效更柔和、偏清新 */
  box-shadow:
    inset 0 0 60rpx rgba(255, 255, 255, 0.3),
    0 20rpx 50rpx rgba(0, 0, 0, 0.15),
    0 0 80rpx rgba(100, 150, 255, 0.2);
}

.table-container.day::after {
  border-color: rgba(24, 144, 255, 0.2);
}

.table-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  width: 300rpx;
  z-index: 10;
}

.phase-display {
  margin-bottom: 20rpx;
}

.day-text {
  font-size: 24rpx;
  color: #888;
}

.phase-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffd700;
}

.timer-circle {
  width: 100rpx;
  height: 100rpx;
  border: 4rpx solid #ff4d4f;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
}

.timer-num {
  font-size: 40rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.center-audio {
  font-size: 22rpx;
  color: #aaa;
  padding: 10rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 10rpx;
}

.voice-limit-tip {
  font-size: 18rpx;
  color: #ff4d4f;
  margin-top: 10rpx;
  opacity: 0.8;
}

.seats-wrapper {
  position: absolute;
  width: 100%;
  height: 100%;
}

.seat-item {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  /* Center the item first */
  width: 120rpx;
  margin-left: -60rpx;
  /* half of width for centering */
  margin-top: -60rpx;
  /* half of height for centering */
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.5s ease;
}

.avatar-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #222;
  border: 4rpx solid #444;
  /* 棋子边缘 */
  position: relative;
  /* 棋子立体感 */
  box-shadow: 0 6rpx 10rpx rgba(0, 0, 0, 0.5);
  transition: all 0.3s ease;
}

.avatar-box.me {
  border-color: #ffd700;
  /* 自己发光 */
  box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.6), 0 6rpx 10rpx rgba(0, 0, 0, 0.5);
  transform: scale(1.05);
  /* 稍微放大 */
}

.avatar-box.me.is-voted {
  border-color: #52c41a;
  box-shadow: 0 0 25rpx #52c41a, 0 6rpx 10rpx rgba(0, 0, 0, 0.5);
}

.avatar-box.is-voter {
  box-shadow: 0 0 15rpx #ffd700;
  border-color: #ffd700;
  animation: voter-glow 2s infinite;
}

.avatar-box.is-voted {
  box-shadow: 0 0 15rpx #52c41a;
  border-color: #52c41a;
  animation: voted-glow 2s infinite;
}

.avatar-box.wolf-halo {
  box-shadow: 0 0 20rpx #ff4d4f;
  border-color: #ff4d4f;
  animation: wolf-pulse 1.5s infinite;
}

@keyframes wolf-pulse {
  0% { box-shadow: 0 0 10rpx #ff4d4f; transform: scale(1.0); }
  50% { box-shadow: 0 0 35rpx #ff4d4f; transform: scale(1.05); }
  100% { box-shadow: 0 0 10rpx #ff4d4f; transform: scale(1.0); }
}

@keyframes voter-glow {
  0% { box-shadow: 0 0 5rpx #ffd700; }
  50% { box-shadow: 0 0 25rpx #ffd700; }
  100% { box-shadow: 0 0 5rpx #ffd700; }
}

@keyframes voted-glow {
  0% { box-shadow: 0 0 5rpx #52c41a; }
  50% { box-shadow: 0 0 25rpx #52c41a; }
  100% { box-shadow: 0 0 5rpx #52c41a; }
}

.status-dot {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #52c41a;
  border-radius: 50%;
  width: 32rpx;
  height: 32rpx;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #fff;
  z-index: 10;
}

.avatar-box.is-acted {
  border-color: #1890ff;
}

.avatar-box.is-confirmed {
  border-color: #52c41a;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666;
  font-size: 40rpx;
}

.seat-badge {
  position: absolute;
  top: -10rpx;
  left: -10rpx;
  background: #444;
  color: #fff;
  font-size: 20rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid #666;
  z-index: 2;
}

.role-badge {
  position: absolute;
  bottom: -15rpx;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #ffd700, #ffae00);
  color: #000;
  font-size: 20rpx;
  font-weight: bold;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.5);
  border: 2rpx solid #fff;
  z-index: 10;
}

/* 玩家标记样式，与角色牌保持一致 */
.player-mark-indicator {
  position: absolute;
  top: -15rpx;
  /* 放到顶部，避免与底部的角色牌冲突 */
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #69c0ff, #1890ff);
  /* 蓝色背景区别于身份牌 */
  color: #fff;
  font-size: 18rpx;
  font-weight: bold;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
  border: 1rpx solid #fff;
  z-index: 10;
}

/* 根据不同标记调整颜色 (可选) */
.player-mark-indicator.wolf_suspect {
  background: linear-gradient(135deg, #ff7875, #ff4d4f);
}

.player-mark-indicator.good {
  background: linear-gradient(135deg, #95de64, #52c41a);
}

.player-mark-indicator.trusted {
  background: linear-gradient(135deg, #ffd666, #ffc53d);
  color: #000;
}

.sheriff-badge {
  position: absolute;
  top: -15rpx;
  right: -15rpx;
  font-size: 36rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
  z-index: 5;
}

.hand-raise-badge {
  position: absolute;
  top: -15rpx;
  left: -15rpx;
  font-size: 36rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
  z-index: 5;
  animation: raiseWave 1.5s infinite ease-in-out;
}

@keyframes raiseWave {

  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-10rpx);
  }
}

.death-icon {
  display: none;
  /* 不再使用图片 */
}

/* 死者头像变灰 */
.seat-item.dead .avatar-img {
  filter: grayscale(100%);
  opacity: 0.6;
}

/* 死亡印章 (CSS实现) */
.seat-item.dead .avatar-box::after {
  content: '☠️';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 50rpx;
  color: #ff4d4f;
  border: 4rpx solid #ff4d4f;
  border-radius: 50%;
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
  z-index: 20;
  pointer-events: none;
  box-shadow: 0 0 10rpx #ff4d4f;
}

/* 移除旧的死者样式干扰 */
.seat-item.dead .seat-badge {
  filter: grayscale(100%);
  background: #666;
}

.target-mark {
  position: absolute;
  bottom: 0;
  right: 0;
  font-size: 30rpx;
}

.poison-mark {
  position: absolute;
  top: 0;
  right: 0;
  font-size: 30rpx;
}

.death-reason-mark {
  position: absolute;
  top: 50%;
  right: -20rpx;
  transform: translateY(-50%);
  font-size: 36rpx;
  z-index: 6;
  text-shadow: 0 0 10rpx rgba(255, 0, 0, 0.5);
}

.check-mark {
  position: absolute;
  top: 50%;
  left: -20rpx;
  transform: translateY(-50%);
  font-size: 36rpx;
  z-index: 6;
  text-shadow: 0 0 10rpx rgba(255, 255, 255, 0.5);
}

.lover-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  font-size: 30rpx;
  z-index: 6;
  text-shadow: 0 0 10rpx rgba(255, 133, 192, 0.8);
}

.seer-mark-judge {
  position: absolute;
  top: -5rpx;
  left: 30%;
  font-size: 32rpx;
  z-index: 7;
  text-shadow: 0 0 10rpx #9c27b0;
}

.guard-mark-judge {
  position: absolute;
  top: -5rpx;
  right: 30%;
  font-size: 32rpx;
  z-index: 7;
  text-shadow: 0 0 10rpx #52c41a;
}

.save-mark-judge {
  position: absolute;
  top: 15rpx;
  right: -15rpx;
  font-size: 32rpx;
  z-index: 7;
  text-shadow: 0 0 10rpx #1890ff;
}

.idiot-badge {
  position: absolute;
  bottom: 0;
  left: 0;
  font-size: 30rpx;
  z-index: 6;
}

.seat-name {
  font-size: 20rpx;
  color: #eee;
  margin-top: 10rpx;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dead .avatar-box {
  filter: grayscale(100%);
  opacity: 0.5;
}

/* 底部面板 */
.setup-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  padding: 0;
  z-index: 100;
  pointer-events: none;
}

.setup-card {
  background: rgba(26, 26, 31, 0.65);
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(255, 255, 255, 0.15);
  pointer-events: auto;
  box-shadow: 0 -20rpx 60rpx rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.count-tip {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 1rpx;
}

.room-capacity {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.05);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.config-grid {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin: 0 0 40rpx;
  background: rgba(255, 255, 255, 0.03);
  padding: 24rpx 30rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  position: relative;
}

.config-grid.clickable:active {
  background: rgba(255, 255, 255, 0.08);
  transform: scale(0.99);
}

.config-item {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
}

.arrow-right {
  color: rgba(255, 255, 255, 0.2);
  font-size: 24rpx;
  margin-left: 10rpx;
}

.lobby-action-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.primary-btn {
  background: linear-gradient(135deg, #ffd700, #ffae00) !important;
  color: #1a1a1f !important;
  margin: 0 !important;
  font-weight: 800;
  border-radius: 50rpx;
  height: 110rpx;
  line-height: 110rpx;
  font-size: 34rpx;
  box-shadow: 0 10rpx 30rpx rgba(255, 215, 0, 0.35), inset 0 2rpx 8rpx rgba(255, 255, 255, 0.4);
  flex: 2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn:active {
  transform: scale(0.98);
  box-shadow: 0 5rpx 15rpx rgba(255, 215, 0, 0.4), inset 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.secondary-btn {
  background: rgba(255, 255, 255, 0.08) !important;
  color: #ffd700 !important;
  margin: 0 !important;
  border-radius: 50rpx;
  height: 110rpx;
  line-height: 110rpx;
  font-size: 32rpx;
  border: 1rpx solid rgba(255, 215, 0, 0.3);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

