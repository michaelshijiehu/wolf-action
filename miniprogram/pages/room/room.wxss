/* --- Game Config Info Bar --- */
/* 游戏进度步进器与事件流 */
.game-extra-info {
  width: 90%;
  margin: 20rpx auto;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  z-index: 5;
}

.day-mode .step-dot {
  background: #ccc;
  border-color: #bbb;
}

.day-mode .step-label {
  color: #999;
}

.day-mode .event-ticker {
  background: rgba(0, 0, 0, 0.03);
  border-color: rgba(0, 0, 0, 0.1);
}

.day-mode .ticker-time {
  color: #888;
}

.day-mode .ticker-text {
  color: #444;
}

.phase-stepper {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 20rpx;
  position: relative;
}

.phase-stepper::before {
  content: "";
  position: absolute;
  top: 10rpx;
  /* Align with dots */
  left: 50rpx;
  right: 50rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.1);
  z-index: 1;
}

.day-mode .phase-stepper::before {
  background: rgba(0, 0, 0, 0.05);
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
  position: relative;
}

.step-dot {
  width: 20rpx;
  height: 20rpx;
  background: #333;
  border: 4rpx solid #444;
  border-radius: 50%;
  margin-bottom: 12rpx;
  transition: all 0.3s;
}

.step-label {
  font-size: 22rpx;
  color: #666;
  transition: all 0.3s;
}

.step-item.active .step-dot {
  background: #ffd700;
  border-color: #fff;
  box-shadow: 0 0 15rpx #ffd700;
  transform: scale(1.2);
}

.step-item.active .step-label {
  color: #ffd700;
  font-weight: bold;
}

.day-mode .step-item.active .step-label {
  color: #e6b800;
  /* Darker gold for light bg */
}

.step-item.passed .step-dot {
  background: #237804;
  /* 深绿色，表示已完成 */
  border-color: #237804;
  opacity: 0.6;
}

.day-mode .step-item.passed .step-dot {
  background: #b7eb8f;
  border-color: #95de64;
}

.event-ticker {
  background: rgba(255, 255, 255, 0.03);
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  min-height: 100rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-shadow: inset 0 2rpx 10rpx rgba(0, 0, 0, 0.2);
}

.ticker-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 10rpx;
  animation: slideUp 0.5s ease-out;
}

.ticker-item:last-child {
  margin-bottom: 0;
}

.ticker-time {
  font-size: 20rpx;
  color: #555;
  padding-top: 4rpx;
  white-space: nowrap;
}

.ticker-text {
  font-size: 24rpx;
  color: #ccc;
  line-height: 1.4;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* --- Game Config Info Bar --- */
.game-config-info {
  display: flex;
  flex-direction: row;
  /* Ensure horizontal */
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  margin-top: 10rpx;
  width: 100%;
  box-sizing: border-box;
}

.config-tag {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
}

.day-mode .config-tag {
  background: rgba(0, 0, 0, 0.05);
  color: #555;
  border-color: rgba(0, 0, 0, 0.1);
}

/* Bottom Game Tools Bar */
.game-tools-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 110rpx;
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(10px);
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 800;
  /* Below Action Panel */
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  opacity: 0.8;
  padding: 10rpx 40rpx;
}

.tool-item:active {
  opacity: 1;
  transform: scale(0.95);
}

.tool-icon {
  font-size: 40rpx;
  margin-bottom: 6rpx;
}

.tool-label {
  font-size: 20rpx;
  color: #ccc;
}

/* 狼人袭击特效 (抓痕) */
.wolf-attack-fx {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  pointer-events: none;
  z-index: 150;
  overflow: hidden;
  border-radius: 50%;
  box-shadow: inset 0 0 30rpx rgba(255, 0, 0, 0.6);
  animation: bloodPulse 1.5s infinite;
}

.scratch {
  position: absolute;
  background: rgba(255, 0, 0, 0.8);
  width: 120%;
  height: 6rpx;
  top: 50%;
  left: -10%;
  box-shadow: 0 0 10rpx #ff0000;
  border-radius: 3rpx;
}

.scratch.s1 { transform: rotate(-40deg) translateY(-20rpx); animation: scratchIn 0.3s ease-out; }
.scratch.s2 { transform: rotate(-40deg); animation: scratchIn 0.3s ease-out 0.1s both; }
.scratch.s3 { transform: rotate(-40deg) translateY(20rpx); animation: scratchIn 0.3s ease-out 0.2s both; }

@keyframes scratchIn {
  0% { width: 0; opacity: 0; transform: rotate(-40deg) translateX(-100rpx); }
  100% { width: 120%; opacity: 1; }
}

@keyframes bloodPulse {
  0%, 100% { box-shadow: inset 0 0 30rpx rgba(255, 0, 0, 0.4); }
  50% { box-shadow: inset 0 0 60rpx rgba(255, 0, 0, 0.8), 0 0 30rpx rgba(255, 0, 0, 0.5); }
}
/* ===== UI Theme Switcher ===== */
